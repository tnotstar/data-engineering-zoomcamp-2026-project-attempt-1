# ==============================================================
# Dockerfile.cloudrun
# Single-stage build for Google Cloud Run:
#   1. Starts from Manticore Search (Gold Layer base)
#   2. Adds Python, Dashboard (Gradio) and Pipeline (Bruin) dependencies
#   3. Executes ETL during build to "bake" the /data/gold index
#   4. Exposes Port 8080 (multi-process via entrypoint)
# ==============================================================

FROM manticoresearch/manticore:latest

USER root

# 1. Install system dependencies (from etl-pipeline and dashboard)
RUN apt-get update && apt-get install -y \
    python3 python3-pip python3-venv \
    curl bash tar bcftools tabix \
    gosu \
    && rm -rf /var/lib/apt/lists/*

# 2. Install Bruin CLI
RUN curl -sL https://github.com/bruin-data/bruin/releases/latest/download/bruin_Linux_x86_64.tar.gz | tar -xz && \
    mv bruin /usr/local/bin/bruin && \
    chmod +x /usr/local/bin/bruin

# 3. Create a virtual environment and install Python dependencies
ENV VIRTUAL_ENV=/opt/venv
RUN python3 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Copy requirements files first for caching
COPY dashboard/requirements.txt /tmp/dashboard-requirements.txt
COPY etl-pipeline/requirements.txt /tmp/etl-requirements.txt
RUN pip install --no-cache-dir -r /tmp/dashboard-requirements.txt -r /tmp/etl-requirements.txt

# 4. Copy project assets
# We'll use /pipeline for ETL and /app for Dashboard
WORKDIR /pipeline
COPY etl-pipeline/ .

WORKDIR /app
COPY dashboard/ .

# 5. Build-time ETL Execution (pre-populating /data/gold)
# Need writable dirs for indices, logs, pids
RUN mkdir -p /data/gold /var/run/manticore /var/log/manticore /tmp/manticore-binlog \
    && chown -R manticore:manticore /data /var/run/manticore /var/log/manticore /tmp/manticore-binlog

# Create build-time Manticore config
RUN printf 'searchd {\n\
  listen = 127.0.0.1:9306:mysql\n\
  listen = 127.0.0.1:9308:http\n\
  pid_file = /var/run/manticore/searchd.pid\n\
  data_dir = /data/gold\n\
  log = /var/log/manticore/searchd.log\n\
  query_log = /var/log/manticore/query.log\n\
  binlog_path = /tmp/manticore-binlog\n\
}\n' > /etc/manticoresearch/manticore.conf

# Run the pipeline during construction
# We bypass docker compose and use 'bruin run' directly after starting manticore
# Run the pipeline during construction
# We bypass docker compose and use 'bruin run' directly after starting manticore
RUN searchd && \
    while ! curl -s http://127.0.0.1:9308/ > /dev/null 2>&1; do sleep 1; done && \
    echo "Manticore is up, starting Bruin pipeline..." && \
    export MANTICORE_URL="http://127.0.0.1:9308" && \
    export number_of_variants=100 && \
    bruin run --force /pipeline --var number_of_variants=100 && \
    echo "Pipeline finished successfully. Fixing permissions..." && \
    chown -R manticore:manticore /data /var/run/manticore /var/log/manticore && \
    ls -R /data && \
    searchd --stopwait

# 6. Final Configuration for Runtime
# Change Manticore config for production (listening on 0.0.0.0)
RUN printf 'searchd {\n\
  listen = 0.0.0.0:9306:mysql\n\
  listen = 0.0.0.0:9308:http\n\
  pid_file = /var/run/manticore/searchd.pid\n\
  data_dir = /data/gold\n\
  log = /var/log/manticore/searchd.log\n\
  query_log = /var/log/manticore/query.log\n\
  binlog_path = /tmp/manticore-binlog\n\
}\n' > /etc/manticoresearch/manticore.conf

COPY deploy-entrypoint.sh /deploy-entrypoint.sh
RUN chmod +x /deploy-entrypoint.sh

# Cloud Run uses the PORT environment variable (default 8080)
ENV PORT=8080
EXPOSE ${PORT}

ENTRYPOINT ["/deploy-entrypoint.sh"]
